diff --git a/cmd/sing-box/cmd_run.go b/cmd/sing-box/cmd_run.go
index 8d6fcaa..0ab778c 100644
--- a/cmd/sing-box/cmd_run.go
+++ b/cmd/sing-box/cmd_run.go
@@ -2,11 +2,13 @@ package main
 
 import (
 	"context"
+	"errors"
 	"io"
 	"os"
 	"os/signal"
 	"path/filepath"
 	runtimeDebug "runtime/debug"
+	"slices"
 	"sort"
 	"strings"
 	"syscall"
@@ -16,6 +18,7 @@ import (
 	C "github.com/sagernet/sing-box/constant"
 	"github.com/sagernet/sing-box/log"
 	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/service/fluxyinspector"
 	E "github.com/sagernet/sing/common/exceptions"
 	"github.com/sagernet/sing/common/json"
 	"github.com/sagernet/sing/common/json/badjson"
@@ -187,6 +190,7 @@ func run() error {
 	previousCtx := globalCtx
 	globalCtx = ctx
 	defer func() { stop(); globalCtx = previousCtx }()
+
 	optionsList, err := readConfig()
 	if err != nil {
 		return err
@@ -195,6 +199,23 @@ func run() error {
 	if err != nil {
 		return err
 	}
+	hasInspector := false
+	for _, item := range options.Services {
+		if item.Type == fluxyinspector.Type {
+			hasInspector = true
+		}
+	}
+	if hasInspector && slices.Contains(configPaths, "stdin") {
+		return errors.New("fluxy-inspector reserves stdin for IPC; use a configuration file")
+	}
+	if hasInspector && options.Log != nil && options.Log.Output == "stdout" {
+		return errors.New("fluxy-inspector reserves stdout for IPC; use stderr for logs")
+	}
+	if hasInspector {
+		globalCtx = fluxyinspector.WithControl(ctx, os.Stdin, os.Stdout, stop)
+	} else {
+		watchHelperInput(stop)
+	}
 	err = runInUserNamespaceIfNeeded(options, optionsList)
 	if err != nil {
 		return err
@@ -216,6 +237,10 @@ func run() error {
 				osSignal = syscall.SIGTERM
 			}
 			if osSignal == syscall.SIGHUP {
+				if hasInspector {
+					log.Warn("fluxy-inspector IPC cannot be reloaded; restart the owning process")
+					continue
+				}
 				err = check()
 				if err != nil {
 					log.Error(E.Cause(err, "reload service"))
diff --git a/cmd/sing-box/fluxy_helper.go b/cmd/sing-box/fluxy_helper.go
index c4e33d1..49fddc4 100644
--- a/cmd/sing-box/fluxy_helper.go
+++ b/cmd/sing-box/fluxy_helper.go
@@ -35,9 +35,12 @@ func helperContext(parent context.Context) (context.Context, context.CancelFunc,
 			}
 		}()
 	}
-	// Pipe EOF also detects helper crashes on Windows.
+	return ctx, cancel, nil
+}
+
+// Only the owner of stdin may read it. Inspector services consume IPC themselves.
+func watchHelperInput(cancel context.CancelFunc) {
 	if os.Getenv("FLUXY_HELPER_STDIN") == "1" {
 		go func() { _, _ = io.Copy(io.Discard, os.Stdin); cancel() }()
 	}
-	return ctx, cancel, nil
 }
