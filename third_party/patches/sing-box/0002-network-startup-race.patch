From 880189359ec3681f57ccebfa35a50003600f826c Mon Sep 17 00:00:00 2001
From: fengqi <fengqi0508@gmail.com>
Date: Wed, 23 Sep 2026 10:36:03 +0800
Subject: [PATCH] fix(route): synchronize network manager startup

---
 route/network.go | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/route/network.go b/route/network.go
index 07de8145f3265d5da8925cc201f383967c3630d0..13bf585a3d17bbb67987e52154df8adb6ff745fc 100644
--- a/route/network.go
+++ b/route/network.go
@@ -9,6 +9,7 @@ import (
 	"runtime"
 	"strings"
 	"sync"
+	"sync/atomic"
 	"syscall"
 	"time"
 
@@ -64,7 +65,7 @@ type NetworkManager struct {
 	interfaceUpdateRunAccess sync.Mutex
 	powerUpdateAccess        sync.Mutex
 	powerUpdateCancel        context.CancelFunc
-	started                  bool
+	started                  atomic.Bool
 }
 
 func NewNetworkManager(ctx context.Context, logger logger.ContextLogger, options option.RouteOptions, dnsOptions option.DNSOptions) (*NetworkManager, error) {
@@ -217,7 +218,7 @@ func (r *NetworkManager) Start(stage adapter.StartStage) error {
 				}
 			}
 		}
-		r.started = true
+		r.started.Store(true)
 	}
 	return nil
 }
@@ -571,7 +572,7 @@ func (r *NetworkManager) updateInterface(ctx context.Context, defaultInterface *
 	if ctx.Err() != nil {
 		return
 	}
-	if !r.started {
+	if !r.started.Load() {
 		return
 	}
 	r.ResetNetwork(ctx)
-- 
