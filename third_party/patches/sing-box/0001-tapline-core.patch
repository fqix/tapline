+				t.Fatalf("upstream protocol %q was rejected: %v", protocol, err)
+			}
+		})
+	}
+}
diff --git a/service/taplineinspector/inbound_control.go b/service/taplineinspector/inbound_control.go
new file mode 100644
index 0000000000000000000000000000000000000000..7ee33f774e491d20ab8f1e2ad4cbc8b5f9c1eec6
--- /dev/null
+++ b/service/taplineinspector/inbound_control.go
@@ -0,0 +1,83 @@
+package taplineinspector
+
+import (
+	"errors"
+	"net/netip"
+	"strings"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+	"github.com/sagernet/sing/service"
+)
+
+// Window inlets are created after the box has started. The inbound manager no
+// longer starts or removes inbounds at runtime, so the inspector owns their
+// lifecycle: each inlet runs in its own scope beneath the service's scope.
+func (s *Service) controlInbound(action, tag string, port int) (int, error) {
+	if !strings.HasPrefix(tag, "tapline-") || len(tag) > 128 || port < 0 || port > 65535 {
+		return 0, errors.New("invalid window inlet")
+	}
+	if action == "inbound-remove" {
+		return 0, s.removeInlet(tag)
+	}
+	registry := service.FromContext[adapter.InboundRegistry](s.ctx)
+	manager := service.FromContext[adapter.InboundManager](s.ctx)
+	if registry == nil || manager == nil {
+		return 0, errors.New("missing inbound registry")
+	}
+	if _, exists := manager.Get(tag); exists {
+		return 0, errors.New("window inlet already exists")
+	}
+	s.inletAccess.Lock()
+	defer s.inletAccess.Unlock()
+	if s.inlets == nil {
+		return 0, errors.New("tapline-inspector is closed")
+	}
+	if _, exists := s.inlets[tag]; exists {
+		return 0, errors.New("window inlet already exists")
+	}
+	address := badoption.Addr(netip.MustParseAddr("127.0.0.1"))
+	options := &option.SocksInboundOptions{ListenOptions: option.ListenOptions{Listen: &address, ListenPort: uint16(port)}}
+	inlet, err := registry.Create(s.ctx, service.FromContext[adapter.Router](s.ctx), s.logger, tag, "tapline-mixed", options)
+	if err != nil {
+		return 0, err
+	}
+	bound, ok := inlet.(interface{ ListenPort() int })
+	if !ok {
+		return 0, errors.New("window inlet cannot report its port")
+	}
+	scope := adapter.NewScope(s.scope.Context(), s.logger)
+	name := "inbound/" + inlet.Type() + "[" + tag + "]"
+	for _, stage := range adapter.ListStartStages {
+		err = scope.Start(name, inlet, stage)
+		if err != nil {
+			return 0, errors.Join(err, scope.Close())
+		}
+	}
+	s.inlets[tag] = scope
+	return bound.ListenPort(), nil
+}
+
+func (s *Service) removeInlet(tag string) error {
+	s.inletAccess.Lock()
+	scope, found := s.inlets[tag]
+	delete(s.inlets, tag)
+	s.inletAccess.Unlock()
+	if !found {
+		return errors.New("unknown window inlet")
+	}
+	return scope.Close()
+}
+
+func (s *Service) closeInlets() error {
+	s.inletAccess.Lock()
+	inlets := s.inlets
+	s.inlets = nil
+	s.inletAccess.Unlock()
+	var err error
+	for _, scope := range inlets {
+		err = errors.Join(err, scope.Close())
+	}
+	return err
+}
diff --git a/service/taplineinspector/service.go b/service/taplineinspector/service.go
new file mode 100644
index 0000000000000000000000000000000000000000..3615230a7b11f10e219a1d7e730569d7c48741e3
--- /dev/null
+++ b/service/taplineinspector/service.go
@@ -0,0 +1,127 @@
+// Package taplineinspector adapts Tapline's HTTP inspection engine (github.com/fqix/tapline/engine) to sing-box.
+package taplineinspector
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+
+	"github.com/fqix/tapline/engine"
+	"github.com/sagernet/sing-box/adapter"
+	boxService "github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+const Type = "tapline-inspector"
+
+type Options struct {
+	PacketEgress string `json:"packet_egress,omitempty"`
+}
+
+type control struct {
+	input    io.ReadCloser
+	output   io.WriteCloser
+	shutdown context.CancelFunc
+	claimed  atomic.Bool
+}
+
+// WithControl grants one inspector service exclusive ownership of the inherited
+// IPC streams. EOF or failure requests shutdown of the owning sing-box instance.
+func WithControl(ctx context.Context, input io.ReadCloser, output io.WriteCloser, shutdown context.CancelFunc) context.Context {
+	return service.ContextWith(ctx, &control{input: input, output: output, shutdown: shutdown})
+}
+
+func Register(registry *boxService.Registry) {
+	boxService.Register[Options](registry, Type, New)
+}
+
+type Service struct {
+	boxService.Adapter
+	ctx          context.Context
+	logger       log.ContextLogger
+	engine       *engine.Engine
+	done         chan struct{}
+	packetEgress string
+	scope        *adapter.Scope
+	inletAccess  sync.Mutex
+	inlets       map[string]*adapter.Scope
+}
+
+func New(ctx context.Context, logger log.ContextLogger, tag string, options Options) (adapter.Service, error) {
+	return &Service{Adapter: boxService.NewAdapter(Type, tag), ctx: ctx, logger: logger, packetEgress: options.PacketEgress}, nil
+}
+
+func (s *Service) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	if stage != adapter.StartStateInitialize {
+		return nil
+	}
+	c := service.FromContext[*control](s.ctx)
+	if c == nil || c.input == nil || c.output == nil || c.shutdown == nil {
+		return errors.New("tapline-inspector requires an exclusive IPC control channel")
+	}
+	if !c.claimed.CompareAndSwap(false, true) {
+		return errors.New("only one tapline-inspector may own the IPC control channel")
+	}
+	var packetDialer func(context.Context, string) (net.Conn, error)
+	if s.packetEgress != "" {
+		manager := service.FromContext[adapter.OutboundManager](s.ctx)
+		packetDialer = func(ctx context.Context, destination string) (net.Conn, error) {
+			if manager == nil {
+				return nil, errors.New("packet egress manager is missing")
+			}
+			egress, ok := manager.Outbound(s.packetEgress)
+			if !ok || egress.Type() == "tapline-inspect" {
+				return nil, errors.New("invalid inspector packet egress")
+			}
+			return egress.DialContext(ctx, N.NetworkUDP, M.ParseSocksaddr(destination))
+		}
+	}
+	s.scope = scope
+	s.inlets = make(map[string]*adapter.Scope)
+	s.engine = engine.NewEngine(engine.WithInboundTag(engine.WithInboundControl(s.ctx, s.controlInbound), inboundTag), c.input, c.output, packetDialer)
+	s.done = make(chan struct{})
+	go func() {
+		defer close(s.done)
+		if err := s.engine.Wait(); err != nil && s.ctx.Err() == nil {
+			s.logger.Error("inspection stopped: ", err)
+		}
+		c.shutdown()
+	}()
+	scope.Add(s.close)
+	return nil
+}
+
+func (s *Service) close() error {
+	err := s.closeInlets()
+	err = errors.Join(err, s.engine.Close())
+	<-s.done
+	return err
+}
+
+func (s *Service) DialContext(ctx context.Context, source netip.AddrPort, destination string, rawHTTP bool) (net.Conn, error) {
+	if s.engine == nil {
+		return nil, errors.New("tapline-inspector is not started")
+	}
+	return s.engine.DialContext(ctx, source, destination, rawHTTP)
+}
+
+func (s *Service) ServePacket(ctx context.Context, conn net.PacketConn, source netip.AddrPort, destination, serverName string, http3 bool) error {
+	if s.engine == nil {
+		return errors.New("tapline-inspector is not started")
+	}
+	return s.engine.ServePacket(ctx, conn, source, destination, serverName, http3)
+}
+
+func inboundTag(ctx context.Context) string {
+	if metadata := adapter.ContextFrom(ctx); metadata != nil {
+		return metadata.Inbound
+	}
+	return ""
+}
