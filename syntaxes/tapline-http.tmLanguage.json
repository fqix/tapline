{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Tapline HTTP",
    "scopeName": "source.tapline-http",
    "patterns": [
        { "include": "#section" },
        { "include": "#request-line" },
        { "include": "#status-line" },
        { "include": "#frame" },
        { "include": "#header" },
        { "include": "#json-body" }
    ],
    "repository": {
        "section": {
            "match": "^(###)\\s+(.*)$",
            "captures": {
                "1": { "name": "punctuation.definition.heading.tapline-http" },
                "2": { "name": "markup.heading.tapline-http" }
            }
        },
        "request-line": {
            "match": "^([A-Z]+)\\s+(\\S+)\\s+(HTTP/[\\d.]+)$",
            "captures": {
                "1": { "name": "keyword.control.method.tapline-http" },
                "2": { "name": "string.unquoted.url.tapline-http" },
                "3": { "name": "constant.language.version.tapline-http" }
            }
        },
        "status-line": {
            "match": "^(HTTP/[\\d.]+)\\s+([1-3]\\d\\d|[45]\\d\\d)?\\s*(.*)$",
            "captures": {
                "1": { "name": "constant.language.version.tapline-http" },
                "2": { "name": "constant.numeric.status.tapline-http" },
                "3": { "name": "string.unquoted.status.tapline-http" }
            }
        },
        "frame": {
            "match": "^([→←])\\s+(\\S+)\\s?(.*)$",
            "captures": {
                "1": { "name": "keyword.operator.direction.tapline-http" },
                "2": { "name": "comment.line.timestamp.tapline-http" },
                "3": { "name": "string.unquoted.frame.tapline-http" }
            }
        },
        "header": {
            "match": "^([!#$%&'*+.^_`|~0-9A-Za-z-]+)(:)\\s*(.*)$",
            "captures": {
                "1": { "name": "entity.name.tag.header.tapline-http" },
                "2": { "name": "punctuation.separator.key-value.tapline-http" },
                "3": { "name": "string.unquoted.header-value.tapline-http" }
            }
        },
        "json-body": {
            "begin": "^(?=[\\[{])",
            "end": "^(?=###|$)",
            "name": "meta.embedded.block.json",
            "patterns": [{ "include": "source.json" }]
        }
    }
}
