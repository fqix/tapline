{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "vscode",
            "mocha"
        ]
    },
    "include": [
        "src",
        "esbuild.mjs",
        "vitest.config.mts"
    ],
    "exclude": [
        "src/webview"
    ]
}
