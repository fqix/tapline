{
    "name": "tapline",
    "displayName": "Tapline",
    "description": "%extension.description%",
    "version": "0.5.0",
    "publisher": "fqix",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/fqix/tapline"
    },
    "engines": {
        "vscode": "^1.95.0",
        "node": ">=24 <25"
    },
    "categories": [
        "Debuggers",
        "Testing",
        "Other"
    ],
    "keywords": [
        "http",
        "https",
        "proxy",
        "capture",
        "network",
        "inspector",
        "grpc",
        "websocket",
        "mitm",
        "har",
        "mcp"
    ],
    "icon": "media/icon.png",
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "tapline",
                    "title": "Tapline",
                    "icon": "media/activity.svg"
                }
            ]
        },
        "views": {
            "tapline": [
                {
                    "id": "tapline.traffic",
                    "name": "%view.traffic%",
                    "contextualTitle": "%view.traffic.title%"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "tapline.traffic",
                "contents": "%view.welcome.certificate%",
                "when": "!tapline.running && tapline.certificateStatus == 'missing'"
            },
            {
                "view": "tapline.traffic",
                "contents": "%view.welcome.certificateTrust%",
                "when": "!tapline.running && tapline.certificateStatus == 'installed'"
            },
            {
                "view": "tapline.traffic",
                "contents": "%view.welcome.certificateTrusted%",
                "when": "!tapline.running && tapline.certificateStatus == 'trusted'"
            },
            {
                "view": "tapline.traffic",
                "contents": "%view.welcome.stopped%",
                "when": "!tapline.running"
            },
            {
                "view": "tapline.traffic",
                "contents": "%view.welcome.running%",
                "when": "tapline.running"
            }
        ],
        "languages": [
            {
                "id": "tapline-http",
                "aliases": [
                    "Tapline HTTP"
                ],
                "extensions": [
                    ".taplinehttp"
                ]
            }
        ],
        "grammars": [
            {
                "language": "tapline-http",
                "scopeName": "source.tapline-http",
                "path": "./syntaxes/tapline-http.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.json": "json"
                }
            }
        ],
        "commands": [
            {
                "command": "tapline.start",
                "title": "%command.start%",
                "enablement": "!tapline.starting",
                "category": "Tapline",
                "icon": "$(play)"
            },
            {
                "command": "tapline.stop",
                "title": "%command.stop%",
                "category": "Tapline",
                "icon": "$(debug-stop)"
            },
            {
                "command": "tapline.toggleRecording",
                "title": "%command.toggleRecording%",
                "category": "Tapline",
                "icon": "$(record)"
            },
            {
                "command": "tapline.clear",
                "title": "%command.clear%",
                "category": "Tapline",
                "icon": "$(clear-all)"
            },
            {
                "command": "tapline.open",
                "title": "%command.open%",
                "category": "Tapline"
            },
            {
                "command": "tapline.openRequestBody",
                "title": "%command.openRequestBody%",
                "category": "Tapline"
            },
            {
                "command": "tapline.openResponseBody",
                "title": "%command.openResponseBody%",
                "category": "Tapline"
            },
            {
                "command": "tapline.copyCurl",
                "title": "%command.copyCurl%",
                "category": "Tapline",
                "icon": "$(terminal)"
            },
            {
                "command": "tapline.copyUrl",
                "title": "%command.copyUrl%",
                "category": "Tapline"
            },
            {
                "command": "tapline.replay",
                "title": "%command.replay%",
                "category": "Tapline",
                "icon": "$(debug-restart)"
            },
            {
                "command": "tapline.delete",
                "title": "%command.delete%",
                "category": "Tapline",
                "icon": "$(trash)"
            },
            {
                "command": "tapline.exportHar",
                "title": "%command.exportHar%",
                "category": "Tapline",
                "icon": "$(export)"
            },
            {
                "command": "tapline.openTerminal",
                "title": "%command.openTerminal%",
                "category": "Tapline",
                "icon": "$(terminal-view-icon)"
            },
            {
                "command": "tapline.copyCertificatePath",
                "title": "%command.copyCertificatePath%",
                "category": "Tapline"
            },
            {
                "command": "tapline.revealCertificate",
                "title": "%command.revealCertificate%",
                "category": "Tapline"
            },
            {
                "command": "tapline.installCertificate",
                "title": "%command.installCertificate%",
                "category": "Tapline",
                "icon": "$(shield)"
            },
            {
                "command": "tapline.trustCertificate",
                "title": "%command.trustCertificate%",
                "category": "Tapline",
                "icon": "$(verified)"
            },
            {
                "command": "tapline.uninstallCertificate",
                "title": "%command.uninstallCertificate%",
                "category": "Tapline",
                "icon": "$(workspace-untrusted)"
            },
            {
                "command": "tapline.checkCertificate",
                "title": "%command.checkCertificate%",
                "category": "Tapline"
            },
            {
                "command": "tapline.showLogs",
                "title": "%command.showLogs%",
                "category": "Tapline",
                "icon": "$(output)"
            },
            {
                "command": "tapline.openHost",
                "title": "%command.openHost%",
                "category": "Tapline"
            },
            {
                "command": "tapline.openText",
                "title": "%command.openText%",
                "category": "Tapline",
                "icon": "$(file-text)"
            },
            {
                "command": "tapline.openSequence",
                "title": "%command.openSequence%",
                "category": "Tapline",
                "icon": "$(list-flat)"
            },
            {
                "command": "tapline.configureMcp",
                "title": "%command.configureMcp%",
                "category": "Tapline",
                "icon": "$(sparkle)"
            },
            {
                "command": "tapline.compose",
                "title": "%command.compose%",
                "category": "Tapline",
                "icon": "$(send)"
            },
            {
                "command": "tapline.rules",
                "title": "%command.rules%",
                "category": "Tapline",
                "icon": "$(symbol-ruler)"
            },
            {
                "command": "tapline.stats",
                "title": "%command.stats%",
                "category": "Tapline",
                "icon": "$(graph)"
            },
            {
                "command": "tapline.addBreakpoint",
                "title": "%command.addBreakpoint%",
                "category": "Tapline",
                "icon": "$(debug-breakpoint)"
            },
            {
                "command": "tapline.compare",
                "title": "%command.compare%",
                "category": "Tapline",
                "icon": "$(diff)"
            },
            {
                "command": "tapline.compareOriginal",
                "title": "%command.compareOriginal%",
                "category": "Tapline"
            },
            {
                "command": "tapline.editNote",
                "title": "%command.editNote%",
                "category": "Tapline"
            },
            {
                "command": "tapline.toggleMark",
                "title": "%command.toggleMark%",
                "category": "Tapline"
            },
            {
                "command": "tapline.copyResponse",
                "title": "%command.copyResponse%",
                "category": "Tapline"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "tapline.start",
                    "when": "view == tapline.traffic && !tapline.running",
                    "group": "navigation@1"
                },
                {
                    "command": "tapline.stop",
                    "when": "view == tapline.traffic && tapline.running",
                    "group": "navigation@1"
                },
                {
                    "command": "tapline.toggleRecording",
                    "when": "view == tapline.traffic && tapline.running",
                    "group": "navigation@2"
                },
                {
                    "command": "tapline.clear",
                    "when": "view == tapline.traffic",
                    "group": "navigation@3"
                },
                {
                    "command": "tapline.openSequence",
                    "when": "view == tapline.traffic",
                    "group": "navigation@5"
                },
                {
                    "command": "tapline.openTerminal",
                    "when": "view == tapline.traffic",
                    "group": "navigation@4"
                },
                {
                    "command": "tapline.exportHar",
                    "when": "view == tapline.traffic",
                    "group": "2_export@1"
                },
                {
                    "command": "tapline.copyCertificatePath",
                    "when": "view == tapline.traffic",
                    "group": "3_cert@1"
                },
                {
                    "command": "tapline.revealCertificate",
                    "when": "view == tapline.traffic",
                    "group": "3_cert@2"
                },
                {
                    "command": "tapline.installCertificate",
                    "when": "view == tapline.traffic && tapline.certificateStatus != 'trusted' && tapline.certificateStatus != 'installed'",
                    "group": "navigation@0"
                },
                {
                    "command": "tapline.trustCertificate",
                    "when": "view == tapline.traffic && tapline.certificateStatus == 'installed'",
                    "group": "navigation@0"
                },
                {
                    "command": "tapline.uninstallCertificate",
                    "when": "view == tapline.traffic && tapline.certificateStatus == 'trusted'",
                    "group": "navigation@0"
                },
                {
                    "command": "tapline.uninstallCertificate",
                    "when": "view == tapline.traffic && tapline.certificateStatus == 'installed'",
                    "group": "3_cert@5"
                },
                {
                    "command": "tapline.checkCertificate",
                    "when": "view == tapline.traffic",
                    "group": "3_cert@6"
                },
                {
                    "command": "tapline.showLogs",
                    "when": "view == tapline.traffic",
                    "group": "4_logs@1"
                },
                {
                    "command": "tapline.configureMcp",
                    "when": "view == tapline.traffic",
                    "group": "4_logs@0"
                },
                {
                    "command": "tapline.compose",
                    "when": "view == tapline.traffic",
                    "group": "navigation@6"
                },
                {
                    "command": "tapline.rules",
                    "when": "view == tapline.traffic",
                    "group": "1_tools@1"
                },
                {
                    "command": "tapline.stats",
                    "when": "view == tapline.traffic",
                    "group": "1_tools@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "tapline.replay",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "inline@1"
                },
                {
                    "command": "tapline.copyCurl",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "inline@2"
                },
                {
                    "command": "tapline.open",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "1_open@1"
                },
                {
                    "command": "tapline.openText",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "1_open@2"
                },
                {
                    "command": "tapline.openRequestBody",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "1_open@2"
                },
                {
                    "command": "tapline.openResponseBody",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "1_open@3"
                },
                {
                    "command": "tapline.copyCurl",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "2_copy@1"
                },
                {
                    "command": "tapline.copyUrl",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "2_copy@2"
                },
                {
                    "command": "tapline.replay",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "3_act@1"
                },
                {
                    "command": "tapline.exportHar",
                    "when": "view == tapline.traffic && viewItem =~ /transaction|host|folder/",
                    "group": "3_act@2"
                },
                {
                    "command": "tapline.delete",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "4_delete@1"
                },
                {
                    "command": "tapline.compose",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "3_act@0"
                },
                {
                    "command": "tapline.addBreakpoint",
                    "when": "view == tapline.traffic && viewItem == transaction",
                    "group": "3_act@3"
                }
            ],
            "commandPalette": [
                {
                    "command": "tapline.open",
                    "when": "false"
                },
                {
                    "command": "tapline.openRequestBody",
                    "when": "false"
                },
                {
                    "command": "tapline.openResponseBody",
                    "when": "false"
                },
                {
                    "command": "tapline.copyCurl",
                    "when": "false"
                },
                {
                    "command": "tapline.copyUrl",
                    "when": "false"
                },
                {
                    "command": "tapline.replay",
                    "when": "false"
                },
                {
                    "command": "tapline.delete",
                    "when": "false"
                },
                {
                    "command": "tapline.openHost",
                    "when": "false"
                },
                {
                    "command": "tapline.openText",
                    "when": "false"
                },
                {
                    "command": "tapline.addBreakpoint",
                    "when": "false"
                },
                {
                    "command": "tapline.compareOriginal",
                    "when": "false"
                },
                {
                    "command": "tapline.editNote",
                    "when": "false"
                },
                {
                    "command": "tapline.toggleMark",
                    "when": "false"
                },
                {
                    "command": "tapline.copyResponse",
                    "when": "false"
                }
            ],
            "webview/context": [
                {
                    "command": "tapline.compare",
                    "when": "webviewId == 'tapline.traffic.panel' && webviewSection == 'requests' && taplineCompareCount == 2",
                    "group": "1_compare"
                },
                {
                    "command": "tapline.compareOriginal",
                    "when": "webviewId == 'tapline.traffic.panel' && webviewSection == 'requests' && taplineReplay",
                    "group": "2_request"
                },
                {
                    "command": "tapline.editNote",
                    "when": "webviewId == 'tapline.traffic.panel' && webviewSection == 'requests'",
                    "group": "2_request"
                },
                {
                    "command": "tapline.toggleMark",
                    "when": "webviewId == 'tapline.traffic.panel' && webviewSection == 'requests'",
                    "group": "2_request"
                },
                {
                    "command": "tapline.copyResponse",
                    "when": "webviewId == 'tapline.traffic.panel' && webviewSection == 'requests'",
                    "group": "2_request"
                }
            ]
        },
        "configuration": {
            "title": "Tapline",
            "properties": {
                "tapline.port": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535,
                    "default": 3606,
                    "description": "%config.port%"
                },
                "tapline.autoStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.autoStart%"
                },
                "tapline.terminal.inject": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.terminal.inject%"
                },
                "tapline.debug.inject": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.debug.inject%"
                },
                "tapline.ssl.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.ssl.enabled%"
                },
                "tapline.ssl.hosts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "*"
                    ],
                    "description": "%config.ssl.hosts%"
                },
                "tapline.maxEntries": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000,
                    "default": 2000,
                    "description": "%config.maxEntries%"
                },
                "tapline.maxBodyKiB": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096,
                    "default": 512,
                    "description": "%config.maxBodyKiB%"
                },
                "tapline.terminal.profiles": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "openssl",
                            "git",
                            "node",
                            "python",
                            "java",
                            "rust",
                            "deno",
                            "grpc"
                        ]
                    },
                    "default": [
                        "openssl",
                        "git"
                    ],
                    "description": "%config.terminal.profiles%"
                },
                "tapline.debug.runtimes": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "openssl",
                                "git",
                                "node",
                                "python",
                                "java",
                                "rust",
                                "deno",
                                "grpc"
                            ]
                        }
                    },
                    "default": {
                        "node": [
                            "node",
                            "grpc"
                        ],
                        "pwa-node": [
                            "node",
                            "grpc"
                        ],
                        "node-terminal": [
                            "node",
                            "grpc"
                        ],
                        "bun": [
                            "node"
                        ],
                        "deno": [
                            "deno"
                        ],
                        "python": [
                            "python",
                            "openssl",
                            "grpc"
                        ],
                        "debugpy": [
                            "python",
                            "openssl",
                            "grpc"
                        ],
                        "go": [
                            "openssl",
                            "grpc"
                        ],
                        "java": [
                            "java"
                        ],
                        "kotlin": [
                            "java"
                        ],
                        "lldb": [
                            "openssl",
                            "grpc"
                        ],
                        "cppdbg": [
                            "openssl",
                            "grpc"
                        ],
                        "cargo-test": [
                            "openssl",
                            "rust"
                        ],
                        "dart": [],
                        "php": [
                            "openssl"
                        ],
                        "ruby": [
                            "openssl"
                        ],
                        "rdbg": [
                            "openssl"
                        ],
                        "coreclr": []
                    },
                    "description": "%config.debug.runtimes%"
                },
                "tapline.mcp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.mcp.enabled%"
                },
                "tapline.mcp.port": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535,
                    "default": 3607,
                    "description": "%config.mcp.port%"
                },
                "tapline.grpc.protoFiles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/*.proto"
                    ],
                    "description": "%config.grpc.protoFiles%"
                },
                "tapline.rules": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "%config.rules%",
                    "items": {
                        "type": "object",
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "enabled": {
                                "type": "boolean",
                                "default": true
                            },
                            "name": {
                                "type": "string"
                            },
                            "kind": {
                                "type": "string",
                                "enum": [
                                    "breakpoint",
                                    "rewrite",
                                    "mapLocal",
                                    "mapRemote",
                                    "block",
                                    "throttle"
                                ],
                                "enumDescriptions": [
                                    "%config.rules.kind.breakpoint%",
                                    "%config.rules.kind.rewrite%",
                                    "%config.rules.kind.mapLocal%",
                                    "%config.rules.kind.mapRemote%",
                                    "%config.rules.kind.block%",
                                    "%config.rules.kind.throttle%"
                                ]
                            },
                            "url": {
                                "type": "string",
                                "description": "%config.rules.url%"
                            },
                            "method": {
                                "type": "string",
                                "description": "%config.rules.method%"
                            },
                            "request": {
                                "type": [
                                    "boolean",
                                    "object"
                                ],
                                "description": "%config.rules.request%",
                                "properties": {
                                    "method": {
                                        "type": "string"
                                    },
                                    "url": {
                                        "type": "object",
                                        "properties": {
                                            "pattern": {
                                                "type": "string"
                                            },
                                            "replacement": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "pattern",
                                            "replacement"
                                        ]
                                    },
                                    "status": {
                                        "type": "integer",
                                        "minimum": 100,
                                        "maximum": 599
                                    },
                                    "headers": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "description": "%config.rules.headers%"
                                    },
                                    "body": {
                                        "type": "string"
                                    },
                                    "bodyReplace": {
                                        "type": "object",
                                        "properties": {
                                            "pattern": {
                                                "type": "string"
                                            },
                                            "replacement": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "pattern",
                                            "replacement"
                                        ]
                                    }
                                }
                            },
                            "response": {
                                "type": [
                                    "boolean",
                                    "object"
                                ],
                                "description": "%config.rules.response%",
                                "properties": {
                                    "method": {
                                        "type": "string"
                                    },
                                    "url": {
                                        "type": "object",
                                        "properties": {
                                            "pattern": {
                                                "type": "string"
                                            },
                                            "replacement": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "pattern",
                                            "replacement"
                                        ]
                                    },
                                    "status": {
                                        "type": "integer",
                                        "minimum": 100,
                                        "maximum": 599
                                    },
                                    "headers": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "description": "%config.rules.headers%"
                                    },
                                    "body": {
                                        "type": "string"
                                    },
                                    "bodyReplace": {
                                        "type": "object",
                                        "properties": {
                                            "pattern": {
                                                "type": "string"
                                            },
                                            "replacement": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "pattern",
                                            "replacement"
                                        ]
                                    }
                                }
                            },
                            "file": {
                                "type": "string",
                                "description": "%config.rules.file%"
                            },
                            "body": {
                                "type": "string",
                                "description": "%config.rules.body%"
                            },
                            "status": {
                                "type": "integer",
                                "minimum": 100,
                                "maximum": 599
                            },
                            "contentType": {
                                "type": "string"
                            },
